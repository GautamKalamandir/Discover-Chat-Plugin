# Copy to .env and fill in. Never commit .env.
# Every provider below is switched by editing this file only — no code changes.

# --- Application ---
ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=false

# --- Database (matches infra/docker-compose.yml defaults) ---
POSTGRES_USER=discover
POSTGRES_PASSWORD=discover
POSTGRES_DB=discover
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://discover:discover@localhost:5432/discover
# Integration tests use a separate database (created automatically)
TEST_DATABASE_URL=postgresql+asyncpg://discover:discover@localhost:5432/discover_test

# --- Data retention (hours). Missing/invalid values fall back to the defaults shown. ---
# Conversations (messages + generated DAX + result metadata) are deleted after this many hours
# WITHOUT ACTIVITY. Fallback: 12. Raw query result rows are never stored.
CONVERSATION_RETENTION_HOURS=12
# Security audit events (who / which model / allowed or denied). Fallback: 2160 (90 days).
AUDIT_RETENTION_HOURS=2160
# Built-in cleanup job. The same job runs standalone with: uv run python -m app.jobs.cleanup
CLEANUP_SCHEDULER_ENABLED=true
# Fallback: 15. Data can outlive its window by up to one interval.
CLEANUP_INTERVAL_MINUTES=15

# --- LLM: groq | openai ---
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.0
LLM_MAX_OUTPUT_TOKENS=2048
GROQ_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# --- Embeddings: local (fastembed) | openai. Switching creates a new index space (ADR 0007). ---
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_CACHE_DIR=.cache/embeddings
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Only for OpenAI-compatible models not known to the backend:
OPENAI_EMBEDDING_DIMENSIONS=

# --- Semantic knowledge / retrieval (ADR 0007). Fallbacks: 12 / 50 / 10 / 7. ---
RETRIEVAL_TOP_K=12
RETRIEVAL_CANDIDATES=50
USER_SCHEMA_CACHE_MINUTES=10
METADATA_SYNC_ON_USE=true
METADATA_STALE_DAYS=7
# AUTH_PROVIDER=dev only: schema payload files standing in for Power BI
DEV_SCHEMA_FIXTURE_DIR=dev-fixtures/schemas
# Optional admin sync CLI app registration (docs/entra-setup.md §4)
ADMIN_CLI_CLIENT_ID=

# --- Power BI query path: fabric_iq_mcp | rest ---
POWERBI_GATEWAY=fabric_iq_mcp
POWERBI_FALLBACK_GATEWAY=rest
FABRIC_IQ_MCP_URL=https://fabriciq.svc.cloud.microsoft/v1/mcp/fabriciq
# Use https://api.fabric.microsoft.com/v1/mcp/fabriciq if your organization uses private links
FABRIC_IQ_TOOL_VARIANT=Fabric.Routing.FabricIQ.V1
FABRIC_IQ_TOKEN_SCOPE=https://api.fabric.microsoft.com/.default
# Query execution (ADR 0006). Fallbacks: 60 / 2 / 120 / 250 / 1000.
POWERBI_QUERY_TIMEOUT_SECONDS=60
POWERBI_MAX_RETRIES=2
POWERBI_REST_QUERIES_PER_MINUTE=120
POWERBI_DEFAULT_MAX_ROWS=250
POWERBI_MAX_ROWS_LIMIT=1000

# --- Authentication: entra | dev ---
# dev  = local development before IT delivers the app registration (ENVIRONMENT must be local/test).
#        Mint tokens with: cd backend && uv run python -m scripts.mint_dev_token --oid user-a
# entra = real Power BI SSO tokens (production and live testing).
AUTH_PROVIDER=dev
DEV_AUTH_SECRET=replace-with-a-random-string-of-at-least-32-characters
JWT_LEEWAY_SECONDS=60

# --- Authorization: which semantic models a user may use (ADR 0005) ---
# How long Power BI's answer is trusted. A denial for a model the user explicitly asks about is
# always re-checked live, so new grants work immediately. Fallbacks: 10 / 2 / 8 / 10.
AUTHZ_ALLOWED_TTL_MINUTES=10
AUTHZ_DENIED_TTL_MINUTES=2
AUTHZ_PROBE_CONCURRENCY=8
AUTHZ_PROBE_TIMEOUT_SECONDS=10
# AUTH_PROVIDER=dev only: who may access which registered model locally (object id -> dataset ids)
DEV_MODEL_ACCESS={"user-a": ["sales-ds", "hr-ds"], "user-b": ["finance-ds"]}

# --- Microsoft Entra ID (values from IT, see docs/entra-setup.md) ---
ENTRA_CLIENT_ID=
ENTRA_APP_ID_URI=
# JSON list, e.g. ["00000000-0000-0000-0000-000000000000"]
ENTRA_ALLOWED_TENANT_IDS=[]
ENTRA_REQUIRED_SCOPE=discoverChatBot09E811F9CAF94C58AD6EEF5D7849A3F7_CV_ForPBI
# Credential for the On-Behalf-Of exchange: certificate (preferred) or secret
ENTRA_CLIENT_CERTIFICATE_PATH=
ENTRA_CLIENT_CERTIFICATE_THUMBPRINT=
ENTRA_CLIENT_SECRET=

# --- HTTP ---
# Sandboxed custom visuals send Origin: null
CORS_ALLOWED_ORIGINS=["null"]
MAX_REQUEST_BODY_BYTES=65536
