{
    "dataRoles": [
        {
            "displayName": "Context fields (optional)",
            "description": "Fields whose current slicer/filter selection is sent with each question.",
            "name": "contextFields",
            "kind": "Grouping"
        }
    ],
    "dataViewMappings": [
        {
            "conditions": [
                {
                    "contextFields": {
                        "max": 5
                    }
                }
            ],
            "table": {
                "rows": {
                    "select": [
                        {
                            "for": {
                                "in": "contextFields"
                            }
                        }
                    ],
                    "dataReductionAlgorithm": {
                        "top": {
                            "count": 1000
                        }
                    }
                }
            }
        }
    ],
    "objects": {
        "dataSource": {
            "properties": {
                "modelId": {
                    "type": {
                        "enumeration": []
                    }
                }
            }
        },
        "appearance": {
            "properties": {
                "title": {
                    "type": {
                        "text": true
                    }
                }
            }
        },
        "developer": {
            "properties": {
                "devUser": {
                    "type": {
                        "text": true
                    }
                }
            }
        }
    },
    "supportsLandingPage": true,
    "supportsEmptyDataView": true,
    "privileges": [
        {
            "name": "WebAccess",
            "essential": true,
            "parameters": [
                "https://localhost:8000"
            ]
        },
        {
            "name": "AADAuthentication",
            "parameters": {
                "COM": "https://chatbot-api.kalamandirltd.com"
            }
        },
        {
            "name": "LocalStorage",
            "essential": false
        }
    ]
}
